    "scenarios": [
      {"id":"s_secure","name":"Secure card payment","description":"Tokenized payment with authenticated internal calls and a verified provider integration.","nodeIds":["n_buyer","n_checkout","n_payment","n_ledger","n_provider"],"edgeIds":["e_checkout","e_intent","e_provider","e_ledger"],"edgeNumbers":{"e_checkout":1,"e_intent":2,"e_provider":3,"e_ledger":4},"boundaryIds":["b_pci","b_prod"],"nodeData":{"n_checkout":{"d_order":"ProcessingNoStorage"},"n_payment":{"d_token":"ProcessingNoStorage"},"n_provider":{"d_token":"ProcessingNoStorage"},"n_ledger":{"d_transaction":"StorageOver48Hours"}},"edgeRequestData":{"e_checkout":["d_order"],"e_intent":["d_order"],"e_provider":["d_token"],"e_ledger":["d_transaction"]},"edgeResponseData":{"e_checkout":[],"e_intent":["d_transaction"],"e_provider":["d_transaction"],"e_ledger":[]}},
      {"id":"s_risky","name":"Risky provider callback","description":"Intentionally insecure: unauthenticated callback crosses the external trust boundary, carries transaction data, and the provider has no owner.","nodeIds":["n_buyer","n_checkout","n_payment","n_ledger","n_provider"],"edgeIds":["e_checkout","e_intent","e_provider","e_callback","e_ledger"],"edgeNumbers":{"e_checkout":1,"e_intent":2,"e_provider":3,"e_callback":4,"e_ledger":5},"boundaryIds":["b_pci","b_prod"],"nodeData":{"n_checkout":{"d_order":"ProcessingNoStorage"},"n_payment":{"d_transaction":""},"n_provider":{"d_transaction":""},"n_ledger":{"d_transaction":"StorageOver48Hours"}},"edgeRequestData":{"e_checkout":["d_order"],"e_intent":["d_order"],"e_provider":["d_token"],"e_callback":["d_transaction"],"e_ledger":["d_transaction"]},"edgeResponseData":{"e_checkout":[],"e_intent":[],"e_provider":[],"e_callback":[],"e_ledger":[]}}
